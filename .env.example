# ============================================================
# Nebula Gateway OneClick configuration
# ============================================================
# Modes:
# - single: legacy one-server NL gateway deployment
# - chain: Home -> NL chain (configure HOME bridge, validate EXIT x-ui inbound)
DEPLOY_MODE=single

# --------------------------
# Local deploy behavior
# --------------------------
AUTO_INSTALL_PARAMIKO=1
LOCAL_ARTIFACTS_DIR=./artifacts
# Existing component policy in single mode:
# ask | rerun | keep
EXISTING_COMPONENT_POLICY=ask

# Remote script upload paths (usually no need to change)
REMOTE_SCRIPT_PATH=/tmp/rebuild_nl_gateway.sh
CHAIN_HOME_REMOTE_SCRIPT_PATH=/tmp/rebuild_home_chain_bridge.sh

# ============================================================
# SINGLE MODE (DEPLOY_MODE=single)
# ============================================================
# SSH target (legacy single-server flow)
SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=root

# Use password or key auth
SSH_PASSWORD=your_ssh_password
SSH_PRIVATE_KEY=
SSH_KEY_PASSPHRASE=
SUDO_PASSWORD=

# Optional deterministic values for profile continuity
SINGLE_TRANSPORT=vless

# Optional per-step overrides for existing components (0=keep, 1=rerun)
RECONFIGURE_XRAY=
RECONFIGURE_NAIVE=
RECONFIGURE_HYSTERIA=
RECONFIGURE_MTPROXY=
RECONFIGURE_HAPP_FEED=

# VLESS settings (used when SINGLE_TRANSPORT=vless)
VLESS_UUID=
REALITY_SNI=www.cloudflare.com
REALITY_DEST=www.cloudflare.com:443
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=

# NaiveProxy settings (used when SINGLE_TRANSPORT=naiveproxy)
# NAIVE_DOMAIN can be empty: script will generate random *.sslip.io domain.
NAIVE_DOMAIN=
NAIVE_PORT=8443
NAIVE_USER=
NAIVE_PASS=
NAIVE_EMAIL=
NAIVE_UPSTREAM=https://www.cloudflare.com

HY2_SNI=www.microsoft.com
HY2_PASSWORD=

MTPROXY_TLS_DOMAIN=www.cloudflare.com
MTPROXY_SECRET=

# Optional Happ/Voxi-compatible subscription layer
HAPP_COMPAT_MODE=0
HAPP_PROFILE_NAME=nebula-gateway
HAPP_SUBSCRIPTION_TOKEN=
HAPP_SUBSCRIPTION_PORT=18080
HAPP_SUBSCRIPTION_PATH=/sub/nebula
HAPP_PUBLIC_HOST=
HAPP_PUSH_URL=
HAPP_PUSH_AUTH_HEADER=

# Optional preflight backup hooks
SKIP_PREFLIGHT_BACKUP=0
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BORG_REPO=
BORG_PASSPHRASE=

# ============================================================
# CHAIN MODE (DEPLOY_MODE=chain)
# ============================================================
# HOME server SSH (bridge node that accepts client connections)
HOME_SSH_HOST=
HOME_SSH_PORT=22
HOME_SSH_USER=root
HOME_SSH_PASSWORD=
HOME_SSH_PRIVATE_KEY=
HOME_SSH_KEY_PASSPHRASE=
HOME_SUDO_PASSWORD=

# EXIT server SSH (NL x-ui host, read-only precheck)
EXIT_SSH_HOST=
EXIT_SSH_PORT=22
EXIT_SSH_USER=root
EXIT_SSH_PASSWORD=
EXIT_SSH_PRIVATE_KEY=
EXIT_SSH_KEY_PASSPHRASE=
EXIT_SUDO_PASSWORD=

# EXIT validation source (currently only xui is supported)
CHAIN_EXIT_PROVIDER=xui
CHAIN_XUI_DB_PATH=/etc/x-ui/x-ui.db
CHAIN_XUI_INBOUND_REMARK=HOME-CHAIN-XHTTP

# Must match EXIT x-ui inbound for Home->NL chain
CHAIN_XHTTP_MODE=packet-up
CHAIN_XHTTP_PATH=/

# Chain behavior toggles
CHAIN_FULL_TUNNEL=1
CHAIN_KEEP_HOME_CLIENT_UUID=1
