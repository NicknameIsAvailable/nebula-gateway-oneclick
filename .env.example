# --------------------------------------------
# SSH connection (required if no interactive input)
# If you leave required fields empty, deploy.py
# will ask you in terminal at start.
# --------------------------------------------
SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=root

# Use one auth method OR both:
# 1) Password auth
SSH_PASSWORD=your_ssh_password

# 2) Key auth (optional)
SSH_PRIVATE_KEY=
SSH_KEY_PASSPHRASE=

# If SSH_USER is not root and sudo asks password:
# (often equals SSH_PASSWORD)
SUDO_PASSWORD=

# --------------------------
# Local deploy behavior
# --------------------------
# Auto install paramiko dependency if missing (1/0)
AUTO_INSTALL_PARAMIKO=1

# Where to upload installer script on remote host
REMOTE_SCRIPT_PATH=/tmp/rebuild_nl_gateway.sh

# Where to save downloaded artifacts on local machine
LOCAL_ARTIFACTS_DIR=./artifacts

# -----------------------------
# Optional deterministic values
# Leave empty to auto-generate new values.
# Fill to restore old client profiles after disaster.
# --------------------------
VLESS_UUID=
REALITY_SNI=www.cloudflare.com
REALITY_DEST=www.cloudflare.com:443
REALITY_PRIVATE_KEY=
REALITY_SHORT_ID=

HY2_SNI=www.microsoft.com
HY2_PASSWORD=

MTPROXY_TLS_DOMAIN=www.cloudflare.com
MTPROXY_SECRET=

# --------------------------
# Optional preflight backup
# If matching backup utility is installed on the server,
# script will try to run a backup before any changes.
# --------------------------
SKIP_PREFLIGHT_BACKUP=0

# restic mode (requires restic installed on server)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# borg mode (requires borg installed on server)
BORG_REPO=
BORG_PASSPHRASE=
